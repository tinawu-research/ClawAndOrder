# Copy to .env for local work, or rely on the organizer-supplied ~/team.env on
# the cluster:  source ~/team.env
#
# Never commit real credentials. .env is gitignored; this example is not.

# ---- Model routing (LiteLLM proxy on the brain/agent node) -----------------
LITELLM_URL=http://localhost:4000/v1
LITELLM_KEY=sk-local-cluster

# Supplied Qwen3.6-35B-A3B-FP8. Owns planning and tool-call generation.
# Participants do not fine-tune this.
BRAIN_MODEL=agent-brain

# The team's fine-tuned Nemotron adapter, served by vLLM on port 8001 of the
# fine-tuning/model node. Owns final answer synthesis only.
DOMAIN_FT_MODEL=domain-ft

# mock = deterministic template synthesis, for pre-training plumbing tests.
# llm  = route synthesis to DOMAIN_FT_MODEL.
# MUST be llm for official evaluation, or the submission does not actually use
# the fine-tuned model. This is now also the code default, so the variable only
# needs setting to deliberately go back to mock.
DOMAIN_PREDICT_MODE=llm

# ---- Datasets --------------------------------------------------------------
# Defaults to the repo's sibling "data set/" directory; override if the corpus
# lives elsewhere on your node.
# DATA_ROOT=/path/to/data set

# Local development only: load just the first N AFR month files to cut the ~25s
# warm-up. MUST be unset for evaluation — a subset produces wrong AFR counts.
# AFR_MAX_FILES=3

# Build the AFR token/corpus index at start-up. Costs ~20s and ~1.7 GB, and
# takes the worst-case AFR query from 22s to under 6s.
AFR_BUILD_INDEX=true

# ---- Agent loop budget -----------------------------------------------------
MAX_AGENT_STEPS=8
# Whole-request budget, synthesis included. Sits below the 60s mark where the
# scorer deducts 20% of earned points.
QUERY_DEADLINE_SECONDS=50
# Held back from that budget for the final synthesis call. Planning stops at
# QUERY_DEADLINE_SECONDS minus this, so the two phases cannot add up past 60s.
# Keep it at or above SYNTHESIS_TIMEOUT_SECONDS, or the worst case spills back
# over the request deadline by the difference.
SYNTHESIS_RESERVE_SECONDS=20
BRAIN_TIMEOUT_SECONDS=22
SYNTHESIS_TIMEOUT_SECONDS=20
TOOL_WORKERS=4

# Attempts for one planning turn, bounded by the deadline above and split
# between them. The brain is a shared 35B model and the harness sends three
# questions at once, so read timeouts happen; without a retry a single one costs
# the whole question. Two rather than three, so each attempt gets a workable
# slice of the planning deadline.
BRAIN_MAX_ATTEMPTS=2
BRAIN_MIN_ATTEMPT_SECONDS=6
BRAIN_RETRY_BACKOFF_SECONDS=0.5

# Output caps. Unbounded, vLLM generates until the context window is full, and
# the reasoning chain is what pushes a planning turn past its timeout. 600
# tokens is ~14s at the ~42 tok/s the brain delivers under three concurrent
# questions; raising it without raising the deadline creates timeouts.
BRAIN_MAX_OUTPUT_TOKENS=600
SYNTHESIS_MAX_OUTPUT_TOKENS=600

# ---- Server ----------------------------------------------------------------
# 0.0.0.0 so the endpoint is reachable however the harness resolves the host.
SERVER_HOST=0.0.0.0

# The package does not mandate an agent port: the harness reads agent.endpoint
# from submission.json, so any port works provided the two agree. The handout
# examples use 5000 and reserve 8001 for the Nemotron vLLM on the model node; we
# use 8001 on the head node, which is free there. Change this and you must
# change submission.json to match.
SERVER_PORT=8001
LOG_LEVEL=INFO

# ---- Optional AFR retrieval service ---------------------------------------
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=afr
# EMBED_MODEL=
